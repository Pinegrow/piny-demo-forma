        "revenue": {"label": "Revenue highlight", "order": 10, "props": {"label": "Project revenue", "value": "€48.2k", "change": "+18.4% this month", "trend": "up", "accent": true}, "preview": "revenue"},
        "capacity": {"label": "Studio capacity", "order": 20, "props": {"label": "Studio capacity", "value": "82%", "change": "A little room for something new", "trend": "neutral"}, "preview": "capacity"},
        "quiet": {"label": "Number only", "order": 30, "props": {"label": "Years of practice", "value": "08", "change": "", "showChange": false}, "preview": "quiet"}
