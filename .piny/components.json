        "title": {"label": "Page title", "group": "Content", "order": 10, "control": "text", "minLength": 1, "maxLength": 90, "allowRemove": false},
        "description": {"label": "Introduction", "group": "Content", "order": 20, "control": "textarea", "maxLength": 240},
        "align": {"label": "Alignment", "group": "Appearance", "order": 30, "control": "select", "initialValue": "left", "options": [{"value": "left", "label": "Left — workspace"}, {"value": "center", "label": "Center — presentation"}]}
      },
      "insert": {"props": {"eyebrow": "THE STUDIO", "title": "Ideas, taking shape.", "description": "A new chapter for thoughtful spaces and objects."}},
      "presets": {
        "collection": {"label": "Collection introduction", "description": "A compact heading for a project collection.", "order": 10, "props": {"eyebrow": "SELECTED WORK", "title": "Made with intention.", "description": "Spaces and objects designed around the way we live."}, "preview": "collection"},
        "centered": {"label": "Centered introduction", "order": 20, "props": {"eyebrow": "FORMA STUDIO", "title": "Room for possibility.", "description": "Architecture, interiors, and the details in between.", "align": "center"}, "preview": "centered"}
