    "metric-card": {
      "source": {"module": "src/components/demo.tsx", "export": "MetricCard"},
      "label": "Studio metric", "category": "FORMA / Insights", "order": 0,
      "description": "One readable studio number, with an optional comparison and directional cue. Values remain authored strings so currencies and units stay intentional.",
      "documentation": ".piny/COMPONENT_GUIDE.md", "keywords": ["stat", "number", "dashboard", "kpi", "revenue"],
