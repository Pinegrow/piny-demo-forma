        "value": {"label": "Display value", "description": "Include any currency or unit, for example €48.2k or 12.", "group": "Content", "order": 10, "minLength": 1, "maxLength": 24},
        "showChange": {"label": "Show comparison", "group": "Comparison", "order": 20, "control": "checkbox", "initialValue": true},
        "change": {"label": "Comparison text", "group": "Comparison", "order": 30, "maxLength": 60, "visibleWhen": {"prop": "showChange", "equals": true}},
        "trend": {"label": "Direction", "group": "Comparison", "order": 40, "control": "select", "options": [{"value": "up", "label": "Increasing ↗"}, {"value": "down", "label": "Decreasing ↘"}, {"value": "neutral", "label": "Unchanged —"}], "visibleWhen": {"prop": "showChange", "equals": true}},
